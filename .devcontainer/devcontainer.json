// OPTIONAL: open this folder inside the build container
// (VS Code: "Dev Containers: Reopen in Container").
//
// Not required for IntelliSense: docker-compose.yml mounts the tree at its
// host path, so build/<target>/compile_commands.json is valid on the host
// once the ARM toolchain and the C/C++ extension are installed there (see
// CLAUDE.md). Use this only if you prefer not to install a toolchain on the
// host; the container already has /usr/bin/arm-none-eabi-g++.
{
	"name": "px4-autopilot (compose)",
	"dockerComposeFile": "../docker-compose.yml",
	"service": "px4",
	"workspaceFolder": "${localWorkspaceFolder}",
	"shutdownAction": "stopCompose",
	// Keep the container alive for the editor; the image entrypoint still runs.
	"overrideCommand": true,

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				"ms-vscode.cmake-tools",
				"chiehyu.vscode-astyle",
				"twxs.cmake",
				"redhat.vscode-yaml",
				"ms-python.python",
				"marus25.cortex-debug"
			],
			"settings": {
				"terminal.integrated.defaultProfile.linux": "bash",
				// Pick the target you built; switch this if you build another board.
				"C_Cpp.default.compileCommands": "${workspaceFolder}/build/px4_fmu-v6x_default/compile_commands.json",
				"C_Cpp.default.compilerPath": "/usr/bin/arm-none-eabi-g++",
				"C_Cpp.default.configurationProvider": "",
				"cmake.configureOnOpen": false
			}
		}
	},

	"forwardPorts": [14556, 14557]
}
